# Local-only. No OpenAI API key is needed. Node 22.13+ required.
QUOTACRAFT_PORT=4318
# Store quota metadata, task prompts and checkpoints locally. Never commit this directory.
# QUOTACRAFT_DATA_DIR=/absolute/private/path
# Enable launching user-created Codex tasks (off by default).
QUOTACRAFT_ALLOW_EXEC=0
# Optional absolute path to codex.exe, codex, or the Codex Node launcher.
# QUOTACRAFT_CODEX_BIN=/absolute/path/to/codex
# Optional: official X API bearer token for public Tibo posts; may incur X API fees.
# X_BEARER_TOKEN=
